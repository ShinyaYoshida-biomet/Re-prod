{
	"compilerOptions": {
		"target": "ES2021",
		"module": "commonjs",
		"moduleResolution": "Node",
		"lib": ["ES2021", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node", "@wdio/globals/types", "@wdio/mocha-framework"]
	},
	"include": ["./**/*.ts"],
	"ts-node": {
		"compilerOptions": {
			"module": "commonjs"
		},
		"transpileOnly": true
	}
}
