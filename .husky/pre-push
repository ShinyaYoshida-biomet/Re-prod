#!/bin/bash
#
# Pre-push hook for Re-prod project
# This hook runs before git push to ensure code quality
#
# Managed by Husky - see package.json prepare script
# To bypass this hook (not recommended), use: git push --no-verify
#

set -e

echo "🚀 Running pre-push checks..."
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track if any checks fail
FAILED=0

# Function to print status
print_status() {
    if [ $1 -eq 0 ]; then
        echo -e "${GREEN}✓${NC} $2"
    else
        echo -e "${RED}✗${NC} $2"
        FAILED=1
    fi
}

# Check 1: Biome formatting (auto-apply)
echo -e "${YELLOW}[1/4]${NC} Formatting with Biome..."
if pnpm format > /dev/null 2>&1; then
    print_status 0 "Biome formatting applied"
else
    print_status 1 "Biome formatting failed"
    echo "  → Run 'pnpm format' to see details"
    echo ""
fi

# Check 2: Rust formatting
echo -e "${YELLOW}[2/4]${NC} Checking Rust formatting..."
if cargo fmt --check --manifest-path core/Cargo.toml > /dev/null 2>&1; then
    print_status 0 "Rust code is properly formatted"
else
    print_status 1 "Rust code formatting issues found"
    echo "  → Run 'cargo fmt' to fix formatting"
    echo ""
fi

# Check 3: Rust linting with Clippy
echo -e "${YELLOW}[3/4]${NC} Running Rust linter (clippy)..."
if cargo clippy --manifest-path core/Cargo.toml --lib --all-features 2>&1 | grep -q "^error\[E"; then
    print_status 1 "Clippy found compilation errors"
    echo "  → Run 'cargo clippy' to see details"
    echo ""
else
    print_status 0 "Clippy checks passed (warnings allowed)"
fi

# Check 4: TypeScript/JavaScript linting
echo -e "${YELLOW}[4/4]${NC} Running TypeScript linter..."
if pnpm run lint > /dev/null 2>&1; then
    print_status 0 "TypeScript/JavaScript linting passed"
else
    print_status 1 "TypeScript/JavaScript linting issues found"
    echo "  → Run 'pnpm run lint' to see details"
    echo ""
fi

# Summary
echo ""
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ All pre-push checks passed!${NC}"
    echo "🚀 Proceeding with push..."
    exit 0
else
    echo -e "${RED}✗ Pre-push checks failed!${NC}"
    echo ""
    echo "Please fix the issues above before pushing."
    echo "To bypass this check (not recommended), use: git push --no-verify"
    exit 1
fi
